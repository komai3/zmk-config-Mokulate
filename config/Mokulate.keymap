#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        td_layer2: td_layer2 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_LAYER2";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&lt 2 LANG1>, <&to 2>;
        };

        ht_layer3: ht_layer3 {
            compatible = "zmk,behavior-hold-tap";
            label = "HT_LAYER3";
            bindings = <&mo>, <&td_layer3>;

            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <180>;
        };

        td_layer3: td_layer3 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_LAYER3";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp LANG2>, <&to 3>;
        };

        td_layer4: td_layer4 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_LAYER4";
            #binding-cells = <0>;
            tapping-term-ms = <180>;
            bindings = <&none>, <&to 4>;
        };

        ht_layer2: ht_layer2 {
            compatible = "zmk,behavior-hold-tap";
            label = "HT_LAYER2";
            bindings = <&mo>, <&td_layer2>;

            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <180>;
        };

        ht_layer4: ht_layer4 {
            compatible = "zmk,behavior-hold-tap";
            label = "HT_LAYER4";
            bindings = <&mo>, <&td_layer4>;

            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <180>;
        };
    };

    combos {
        compatible = "zmk,combos";

        ctrl {
            bindings = <&kp LCTRL>;
            key-positions = <4 3>;
            layers = <2>;
        };

        Alt {
            bindings = <&kp LEFT_ALT>;
            key-positions = <15 16>;
            layers = <2>;
        };

        senhaba_y {
            bindings = <&kp Y>;
            key-positions = <5 4>;
            layers = <2>;
        };

        alt_num2 {
            bindings = <&kp LA(KP_NUMBER_2)>;
            key-positions = <3 2>;
            layers = <2>;
        };

        alt_num0 {
            bindings = <&kp LA(KP_NUMBER_0)>;
            key-positions = <2 1>;
            layers = <2>;
        };

        ctrl_alt {
            bindings = <&ctrl_alt>;
            key-positions = <1 13>;
            layers = <2>;
        };
    };

    macros {
        ctrl_Z: ctrl_Z {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(Z)>;
            label = "CTRL_Z";
        };

        win_z: win_z {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(Z)>;
            label = "WIN_Z";
        };

        ctrl_alt: ctrl_alt {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LCTRL &kp LEFT_ALT>;
            label = "CTRL_ALT";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp Q      &kp W         &kp E         &kp R       &kp T        &kp ESC       &kp Y      &kp U          &kp I      &kp O           &kp P           &kp MINUS
&kp A      &kp S         &kp D         &kp F       &kp G        &kp TAB       &kp H      &kp J          &kp K      &kp L           &kp SLASH       &kp LBKT
&kp Z      &lt 4 X       &kp C         &kp V       &kp B        &td_layer3    &kp N      &kp M          &kp COMMA  &kp PERIOD      &kp UP_ARROW    &kp RBKT
&kp LCTRL  &kp LEFT_WIN  &kp LEFT_ALT  &kp LSHIFT  &lt 1 SPACE  &td_layer2    &kp ENTER  &kp BACKSPACE  &kp DEL    &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW
            >;
        };

        SYMBOL {
            display-name = "Func";
            bindings = <
&kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5  &kp ESC    &kp NUMBER_6  &kp NUMBER_7  &kp NUMBER_8   &kp NUMBER_9    &kp NUMBER_0       &kp TILDE
&kp F1        &kp F2        &kp F3        &kp F4        &kp F5        &kp F6     &kp QMARK     &kp EXCL      &kp EQUAL      &kp BSLH        &kp LS(MINUS)      &kp LPAR
&kp F7        &kp F8        &kp F9        &kp F10       &kp F11       &kp F12    &kp AT_SIGN   &kp PERCENT   &kp SEMICOLON  &kp APOSTROPHE  &mt PG_UP HOME     &kp RPAR
&kp LCTRL     &kp LEFT_WIN  &kp LEFT_ALT  &kp LSHIFT    &kp SPACE     &none      &kp ENTER     &kp DEL       &kp HASH       &kp AMPS        &mt PAGE_DOWN END  &kp GRAVE
            >;
        };

        CURSOR {
            display-name = "CS";
            bindings = <
&kp GRAVE  &kp J   &kp G          &kp E                &ctrl_Z         &kp P            &kp LPAR         &kp KP_SLASH     &kp KP_PLUS    &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9
&mo 4      &kp W   &kp LC(D)      &kp M                &kp F4          &kp LC(S)        &kp RPAR         &kp KP_MULTIPLY  &kp KP_MINUS   &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6
&kp LC(B)  &kp F5  &kp LC(LS(D))  &kp DEL              &kp LEFT_SHIFT  &kp LS(LC(F))    &kp LEFT_ARROW   &kp KP_NUMLOCK   &kp UNDER      &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3
&kp O      &kp I   &kp LC(LS(I))  &kp LC(KP_NUMBER_0)  &kp SPACE       &kp Z            &kp RIGHT_ARROW  &to 0            &kp BACKSPACE  &kp KP_NUMBER_0  &kp KP_DOT       &kp KP_ENTER
            >;
        };

        NUMBER {
            display-name = "Miro/Pc";
            bindings = <
&kp ESC         &kp LC(LS(L))  &kp PAGE_UP       &kp E      &ctrl_Z          &kp P            &kp LG(J)     &kp V           &kp LG(BACKSPACE)  &kp LG(D)          &kp S   &kp L
&kp BACKSPACE   &kp G          &kp PAGE_DOWN     &kp N      &kp KP_NUMBER_3  &kp V            &kp SPACE     &kp LG(X)       &kp E              &kp LEFT_ALT       &win_z  &kp B
&kp LEFT_SHIFT  &kp LC(X)      &kp LC(V)         &kp LC(C)  &kp LC(D)        &kp LC(LS(F))    &to 0         &kp LG(V)       &kp LG(O)          &kp LG(SEMICOLON)  &kp C   &kp RBKT
&kp LCTRL       &kp LEFT_WIN   &kp LC(LEFT_ALT)  &kp TAB    &kp SPACE        &mkp RCLK        &kp LEFT_WIN  &kp LEFT_SHIFT  &kp LG(U)          &kp LG(B)          &kp X   &kp LBKT
            >;
        };

        BLUETOOTH {
            display-name = "BT";
            bindings = <
&kp ESC  &kp LC(NUMBER_6)  &kp LS(LC(T))  &kp LC(NUMBER_7)  &kp LC(NUMBER_5)  &kp LC(NUMBER_3)       &none   &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&none    &kp C             &kp U          &kp LS(Q)         &kp LS(I)         &kp B                  &none   &none         &none         &none         &none         &bt BT_CLR
&none    &none             &none          &kp F3            &kp T             &kp LC(KP_NUMBER_9)    &none   &none         &none         &none         &none         &bt BT_CLR_ALL
&to 0    &none             &kp LC(E)      &kp K             &kp ENTER         &kp LC(KP_NUMBER_3)    &trans  &trans        &none         &none         &none         &trans
            >;
        };
    };
};
