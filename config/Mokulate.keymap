#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        td_layer2: td_layer2 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_LAYER2";
            #binding-cells = <0>;
            tapping-term-ms = <180>;
            bindings = <&none>, <&to 2>;
        };

        ht_layer3: ht_layer3 {
            compatible = "zmk,behavior-hold-tap";
            label = "HT_LAYER3";
            bindings = <&mo>, <&td_layer3>;

            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <180>;
        };

        td_layer3: td_layer3 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_LAYER3";
            #binding-cells = <0>;
            tapping-term-ms = <180>;
            bindings = <&none>, <&to 3>;
        };

        td_layer4: td_layer4 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_LAYER4";
            #binding-cells = <0>;
            tapping-term-ms = <180>;
            bindings = <&none>, <&to 4>;
        };

        ht_layer2: ht_layer2 {
            compatible = "zmk,behavior-hold-tap";
            label = "HT_LAYER2";
            bindings = <&mo>, <&td_layer2>;

            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <180>;
        };

        ht_layer4: ht_layer4 {
            compatible = "zmk,behavior-hold-tap";
            label = "HT_LAYER4";
            bindings = <&mo>, <&td_layer4>;

            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <180>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q      &kp W         &kp E         &kp R      &kp T       &kp ESC           &kp LEFT_BRACKET   &kp Y          &kp U      &kp I           &kp O           &kp P
&kp A      &kp S         &kp D         &kp F      &kp G       &kp TAB           &kp RIGHT_BRACKET  &kp H          &kp J      &kp K           &kp L           &kp SLASH
&kp Z      &kp X         &kp C         &kp V      &kp B       &ht_layer2 2 0    &ht_layer3 3 0     &kp N          &kp M      &kp COMMA       &kp PERIOD      &kp UP_ARROW
&kp LCTRL  &kp LEFT_WIN  &kp LEFT_ALT  &kp LANG2  &kp LSHIFT  &lt 1 SPACE       &kp ENTER          &kp BACKSPACE  &kp LANG1  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW
            >;
        };

        SYMBOL {
            bindings = <
&kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5    &kp ESC      &kp LEFT_PARENTHESIS   &kp NUMBER_6  &kp NUMBER_7   &kp NUMBER_8    &kp NUMBER_9     &kp NUMBER_0
&kp F1        &kp F2        &kp F3        &kp F4        &kp F5          &kp F6       &kp RIGHT_PARENTHESIS  &kp GRAVE     &kp EQUAL      &kp BSLH        &kp LS(MINUS)    &kp TILDE
&kp F7        &kp F8        &kp F9        &kp F10       &kp F11         &kp F12      &kp AT_SIGN            &kp PERCENT   &kp SEMICOLON  &kp APOSTROPHE  &kp SLASH        &kp PAGE_UP
&kp LCTRL     &kp LEFT_WIN  &kp LEFT_ALT  &none         &kp LEFT_SHIFT  &kp SPACE    &kp ENTER              &kp DEL       &none          &kp QUESTION    &kp EXCLAMATION  &kp PAGE_DOWN
            >;
        };

        CURSOR {
            bindings = <
&kp GRAVE  &kp C   &kp J          &kp E                &kp LC(Z)       &kp P            &kp LPAR        &kp KP_SLASH     &kp KP_PLUS    &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9
&mo 4      &kp W   &kp LC(D)      &kp M                &kp F4          &kp LC(S)        &kp RPAR        &kp KP_MULTIPLY  &kp KP_MINUS   &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6
&kp LC(B)  &kp F5  &kp LC(LS(D))  &kp DEL              &kp LEFT_SHIFT  &kp LS(LC(F))    &to 0           &kp KP_NUMLOCK   &kp UNDER      &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3
&kp O      &kp I   &kp LC(LS(I))  &kp LC(KP_NUMBER_0)  &kp SPACE       &kp Z            &kp LEFT_ARROW  &kp RIGHT_ARROW  &kp BACKSPACE  &kp KP_NUMBER_0  &kp KP_DOT       &kp KP_ENTER
            >;
        };

        NUMBER {
            bindings = <
&kp ESC         &kp LC(LS(L))  &kp PAGE_UP       &kp E      &kp LC(Z)        &kp P            &kp LG(J)     &kp V           &kp LG(BACKSPACE)  &kp LG(D)          &kp S      &kp L
&kp BACKSPACE   &kp G          &kp PAGE_DOWN     &kp N      &kp KP_NUMBER_3  &kp V            &kp SPACE     &kp LG(X)       &kp E              &kp LEFT_ALT       &kp LG(Z)  &kp B
&kp LEFT_SHIFT  &kp LC(X)      &kp LC(V)         &kp LC(C)  &kp LC(D)        &kp LC(LS(F))    &to 0         &kp LG(V)       &kp LG(O)          &kp LG(SEMICOLON)  &kp C      &kp RBKT
&kp LCTRL       &kp LEFT_WIN   &kp LC(LEFT_ALT)  &kp TAB    &kp SPACE        &mkp RCLK        &kp LEFT_WIN  &kp LEFT_SHIFT  &kp LG(U)          &kp LG(B)          &kp X      &kp LBKT
            >;
        };

        BLUETOOTH {
            bindings = <
&kp ESC  &kp LC(NUMBER_6)  &kp LS(LC(T))  &kp LC(NUMBER_7)  &kp LC(NUMBER_5)  &kp LC(NUMBER_3)       &none   &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&none    &kp U             &kp G          &kp LS(Q)         &kp LS(I)         &kp B                  &none   &none         &none         &none         &none         &bt BT_CLR
&none    &none             &none          &kp F3            &kp T             &kp LC(KP_NUMBER_9)    &none   &none         &none         &none         &none         &bt BT_CLR_ALL
&to 0    &none             &kp LC(E)      &kp K             &kp ENTER         &kp LC(KP_NUMBER_3)    &trans  &trans        &none         &none         &none         &trans
            >;
        };
    };
};
